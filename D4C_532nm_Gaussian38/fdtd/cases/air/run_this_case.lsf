case_dir=filedirectory(currentscriptname);
# SI units; new project; finite Gaussian, all four boundaries PML.
newproject;
addfdtd;
set("dimension","2D");
set("x",0);
set("x span",0.000192);
set("y min",-7.9999999999999996e-07);
set("y max",2.5000000000000002e-06);
set("z",0);
set("mesh type","uniform");
set("dx",2e-08);
set("dy",1e-08);
set("mesh refinement","conformal variant 0");
set("simulation time",6.0000000000000007e-13);
set("auto shutoff min",1.0000000000000001e-09);
set("pml profile",1);
set("pml layers",32);
set("x min bc","PML");
set("x max bc","PML");
set("y min bc","PML");
set("y max bc","PML");
addgaussian;
set("name","source");
set("injection axis","y-axis");
set("direction","backward");
set("use scalar approximation",1);
set("waist radius w0",1.9000000000000001e-05);
set("distance from waist",-1.35e-06);
set("x",0);
set("x span",0.00020000000000000001);
set("y",1.35e-06);
set("z",0);
set("angle theta",0);
set("polarization angle",90);
set("amplitude",1);
set("phase",0);
set("wavelength start",4.9999999999999998e-07);
set("wavelength stop",5.9999999999999997e-07);
addpower;
set("name","R");
set("monitor type","Linear X");
set("x",0);
set("x span",0.000184);
set("y",1.7999999999999999e-06);
set("z",0);
set("spatial interpolation","specified position");
set("override global monitor settings",1);
set("sample spacing","custom");
set("custom frequency samples",[563519657894736.75]);
addpower;
set("name","R2");
set("monitor type","Linear X");
set("x",0);
set("x span",0.000184);
set("y",1.9999999999999999e-06);
set("z",0);
set("spatial interpolation","specified position");
set("override global monitor settings",1);
set("sample spacing","custom");
set("custom frequency samples",[563519657894736.75]);
addpower;
set("name","INC");
set("monitor type","Linear X");
set("x",0);
set("x span",0.000184);
set("y",7.9999999999999996e-07);
set("z",0);
set("spatial interpolation","specified position");
set("override global monitor settings",1);
set("sample spacing","custom");
set("custom frequency samples",[563519657894736.75]);
addpower;
set("name","T");
set("monitor type","Linear X");
set("x",0);
set("x span",0.000184);
set("y",-5.9999999999999997e-07);
set("z",0);
set("spatial interpolation","specified position");
set("override global monitor settings",1);
set("sample spacing","custom");
set("custom frequency samples",[563519657894736.75]);
save(case_dir+"/reproduction.fsp");
run("FDTD");
save;
