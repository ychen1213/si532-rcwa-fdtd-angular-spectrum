# SI units. canonical z increases into substrate; exp(-i omega t).
newproject;
material_id=addmaterial("(n,k) Material");
setmaterial(material_id,"name","Si532_fitted_fixed");
setmaterial("Si532_fitted_fixed","Refractive Index",4.1498733110360151);
setmaterial("Si532_fitted_fixed","Imaginary Refractive Index",0.048334940479862018);
addrect;
set("name","substrate");
set("x min",-1.9999999999999999e-06);
set("x max",1.9999999999999999e-06);
set("y min",-9.9999999999999995e-07);
set("y max",9.9999999999999995e-07);
set("z min",9.9999999999999995e-08);
set("z max",5.9999999999999997e-07);
set("material","Si532_fitted_fixed");
addrect;
set("name","ridge");
set("x min",-4.9999999999999998e-07);
set("x max",4.9999999999999998e-07);
set("y min",-9.9999999999999995e-07);
set("y max",9.9999999999999995e-07);
set("z min",0);
set("z max",9.9999999999999995e-08);
set("material","Si532_fitted_fixed");
addrcwa;
set("name","RCWA");
set("simulation region","2D Y-normal");
set("propagation axis","z");
set("propagation direction","forward");
set("x min",-9.9999999999999995e-07);
set("x max",9.9999999999999995e-07);
set("y",0);
set("z min",-2.9999999999999999e-07);
set("z max",3.9999999999999998e-07);
set("background material","<Object defined dielectric>");
set("index",1);
set("interface position","absolute");
set("interface absolute positions",[-1.9999999999999999e-07,0,9.9999999999999995e-08,1.9999999999999999e-07]);
set("max number k vectors",80);
set("use li factorization",0);
set("mesh type","custom");
set("mesh cells x",400);
set("mesh refinement","staircase");
set("fit materials with multi-coefficient model",0);
set("incident angle","table");
set("incident angle table",[0,0]);
set("sample spacing","custom");
set("custom frequency samples",[563519657894736.75]);
set("report grating characterization",1);
set("report grating power",1);
set("report grating orders",1);
set("report field amplitudes",1);
set("report index",1);
save("model.fsp");
run;
save("model.fsp");
grating_characterization=getresult("RCWA","grating_characterization");
grating_power=getresult("RCWA","grating_power");
grating_orders=getresult("RCWA","grating_orders");
field_amplitudes=getresult("RCWA","field_amplitudes");
total_energy=getresult("RCWA","total_energy");
substrate=getresult("RCWA","substrate");
index=getresult("RCWA","index");
matlabsave("native_datasets.mat",grating_characterization,grating_power,grating_orders,field_amplitudes,total_energy,substrate,index);
